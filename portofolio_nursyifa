function hitungModulo() {
    let a = Number(document.getElementById("angka").value);
    let m = Number(document.getElementById("modulo").value);

    let hasil = document.getElementById("hasilModulo");

    if (
        document.getElementById("angka").value === "" ||
        document.getElementById("modulo").value === ""
    ) {
        hasil.innerHTML = "Silakan isi kedua angka terlebih dahulu.";
        return;
    }

    if (!Number.isInteger(a) || !Number.isInteger(m)) {
        hasil.innerHTML = "Masukkan bilangan bulat.";
        return;
    }

    if (m <= 0) {
        hasil.innerHTML = "Nilai modulo harus lebih dari 0.";
        return;
    }

    let sisa = ((a % m) + m) % m;

    hasil.innerHTML = `
        <strong>Hasil: ${a} mod ${m} = ${sisa}</strong>
        <br>
        Proses: ${a} = (${Math.floor(a / m)}) × ${m} + ${sisa}
    `;
}
function cekKongruen() {
    let a = Number(document.getElementById("angkaA").value);
    let b = Number(document.getElementById("angkaB").value);
    let m = Number(document.getElementById("angkaM").value);

    let hasil = document.getElementById("hasilKongruen");

    if (
        document.getElementById("angkaA").value === "" ||
        document.getElementById("angkaB").value === "" ||
        document.getElementById("angkaM").value === ""
    ) {
        hasil.innerHTML = "Silakan isi semua angka terlebih dahulu.";
        return;
    }

    if (!Number.isInteger(a) || !Number.isInteger(b) || !Number.isInteger(m)) {
        hasil.innerHTML = "Masukkan bilangan bulat.";
        return;
    }

    if (m <= 0) {
        hasil.innerHTML = "Modulo harus lebih dari 0.";
        return;
    }

    let sisaA = ((a % m) + m) % m;
    let sisaB = ((b % m) + m) % m;

    if (sisaA === sisaB) {
        hasil.innerHTML = `
            <strong>BENAR ✓ — KONGRUEN</strong>
            <br>${a} ≡ ${b} (mod ${m})
            <br>Sisa ${a} ÷ ${m} = ${sisaA}
            <br>Sisa ${b} ÷ ${m} = ${sisaB}
        `;
    } else {
        hasil.innerHTML = `
            <strong>SALAH ✗ — TIDAK KONGRUEN</strong>
            <br>${a} ≢ ${b} (mod ${m})
            <br>Sisa ${a} ÷ ${m} = ${sisaA}
            <br>Sisa ${b} ÷ ${m} = ${sisaB}
        `;
    }
}
// FITUR 3: KALKULATOR SISTEM BILANGAN

function konversiBilangan() {
    let input = document.getElementById("nilaiBilangan").value.trim();
    let basis = Number(document.getElementById("basisAsal").value);
    let hasil = document.getElementById("hasilBilangan");

    if (input === "") {
        hasil.innerHTML = "Silakan masukkan angka terlebih dahulu.";
        return;
    }

    let nilai = parseInt(input, basis);

    if (
        !Number.isInteger(nilai) ||
        nilai.toString(basis).toLowerCase() !== input.toLowerCase()
    ) {
        hasil.innerHTML = "Angka tidak valid untuk basis yang dipilih.";
        return;
    }

    hasil.innerHTML = `
        <strong>HASIL KONVERSI</strong><br><br>
        Biner (2): ${nilai.toString(2)}<br>
        Desimal (10): ${nilai.toString(10)}<br>
        Oktal (8): ${nilai.toString(8)}<br>
        Heksadesimal (16): ${nilai.toString(16).toUpperCase()}
    `;
}


// FITUR 4: KALKULATOR KOMBINATORIKA

function faktorial(n) {
    let hasil = 1;

    for (let i = 1; i <= n; i++) {
        hasil *= i;
    }

    return hasil;
}

function hitungKombinatorika() {
    let inputN = document.getElementById("nilaiN").value;
    let inputR = document.getElementById("nilaiR").value;
    let hasil = document.getElementById("hasilKombinatorika");

    if (inputN === "" || inputR === "") {
        hasil.innerHTML = "Silakan isi nilai n dan r.";
        return;
    }

    let n = Number(inputN);
    let r = Number(inputR);

    if (
        !Number.isInteger(n) ||
        !Number.isInteger(r) ||
        n < 0 ||
        r < 0 ||
        r > n ||
        n > 170
    ) {
        hasil.innerHTML = "Masukkan bilangan bulat dengan 0 ≤ r ≤ n dan n maksimal 170.";
        return;
    }

    let permutasi = faktorial(n) / faktorial(n - r);
    let kombinasi = faktorial(n) / (faktorial(r) * faktorial(n - r));

    hasil.innerHTML = `
        <strong>HASIL PERHITUNGAN</strong><br><br>

        <b>1. Permutasi</b><br>
        P(${n}, ${r}) = ${n}! / (${n}-${r})!<br>
        Hasil = ${permutasi}<br><br>

        <b>2. Kombinasi</b><br>
        C(${n}, ${r}) = ${n}! / (${r}! × (${n}-${r})!)<br>
        Hasil = ${kombinasi}
    `;
}
