/* ===== FLOATING BUBBLES ===== */

#home {
    position: relative;
    overflow: hidden;
}

.floating-bubbles {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 1;
}

.floating-bubbles span {
    position: absolute;
    bottom: -80px;
    width: 25px;
    height: 25px;
    border: 2px solid #f28fb8;
    border-radius: 50%;
    background: #ffffff55;
    animation: bubbleFloat 10s linear infinite;
}

.floating-bubbles span:nth-child(1) {
    left: 10%;
    animation-duration: 9s;
}

.floating-bubbles span:nth-child(2) {
    left: 25%;
    width: 40px;
    height: 40px;
    animation-duration: 12s;
    animation-delay: 2s;
}

.floating-bubbles span:nth-child(3) {
    left: 50%;
    animation-duration: 8s;
    animation-delay: 1s;
}

.floating-bubbles span:nth-child(4) {
    left: 70%;
    width: 35px;
    height: 35px;
    animation-duration: 11s;
    animation-delay: 3s;
}

.floating-bubbles span:nth-child(5) {
    left: 85%;
    animation-duration: 10s;
    animation-delay: 1.5s;
}

.floating-bubbles span:nth-child(6) {
    left: 40%;
    width: 18px;
    height: 18px;
    animation-duration: 13s;
    animation-delay: 4s;
}

@keyframes bubbleFloat {
    0% {
        transform: translateY(0) scale(0.7);
        opacity: 0;
    }
    15% {
        opacity: 0.7;
    }
    85% {
        opacity: 0.6;
    }
    100% {
        transform: translateY(-100vh) scale(1.2);
        opacity: 0;
    }
}

/* ===== STAR AND HEART MOTION ===== */

.star {
    animation: starMove 3s ease-in-out infinite alternate;
}

.heart {
    animation: heartMove 2.5s ease-in-out infinite;
}

.sparkle {
    animation: sparkleMove 2s ease-in-out infinite alternate;
}

@keyframes starMove {
    from { transform: rotate(-15deg) translateY(0); }
    to { transform: rotate(15deg) translateY(-15px); }
}

@keyframes heartMove {
    0%, 100% { transform: translateY(0) scale(1); }
    50% { transform: translateY(-15px) scale(1.12); }
}

@keyframes sparkleMove {
    from { transform: scale(0.8) rotate(0deg); opacity: 0.5; }
    to { transform: scale(1.2) rotate(25deg); opacity: 1; }
}

/* ===== CARD HOVER ===== */

.learning-card,
.profile-card {
    transition: transform 0.35s ease, box-shadow 0.35s ease;
}

.learning-card:hover,
.profile-card:hover {
    transform: translateY(-7px);
}

/* Hormati pengaturan pengurangan gerakan */
@media (prefers-reduced-motion: reduce) {
    .floating-bubbles span,
    .star,
    .heart,
    .sparkle {
        animation: none !important;
    }
}
